<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" id="item_holsters" elementFormDefault="qualified">
  <xs:element name="base">
    <xs:annotation>
      <xs:appinfo>
        <appSpecificNote>AlwaysPreferMerge</appSpecificNote>
      </xs:appinfo>
    </xs:annotation>    
    <xs:complexType>
      <xs:all>
        <xs:element name="item_holsters">
          <xs:annotation>
            <xs:appinfo>
              <appSpecificNote>AlwaysPreferMerge</appSpecificNote>
            </xs:appinfo>
          </xs:annotation>          
          <xs:complexType>
            <xs:sequence>
              <xs:element name="item_holster" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="id" type="xs:string" use="required"/>
                  <xs:attribute name="equip_action" type="xs:string" use="optional"/>
                  <xs:attribute name="equip_action_left_stance" type="xs:boolean" use="optional"/>
                  <xs:attribute name="unequip_action" type="xs:string" use="optional"/>
                  <xs:attribute name="unequip_action_left_stance" type="xs:string" use="optional"/>
                  <xs:attribute name="show_holster_when_drawn" type="xs:string" use="optional"/>
                  <xs:attribute name="group_name" type="xs:string" use="optional"/>
                  <xs:attribute name="holster_skeleton" type="xs:string" use="optional"/>
                  <xs:attribute name="holster_bone" type="xs:string" use="optional"/>
                  <xs:attribute name="holster_position" type="xs:string" use="optional"/>
                  <xs:attribute name="holster_rotation_yaw_pitch_roll" type="xs:string" use="optional"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
      
          <!-- id attribute is unique for item_holster -->
          <xs:unique name="item_holster_unique_attribute">
            <xs:selector xpath="item_holster"/>
            <xs:field xpath="@id"/>
          </xs:unique>      
        </xs:element>        
      </xs:all>
    </xs:complexType>
  </xs:element>
</xs:schema>